generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// output   = "../app/generated/prisma"

enum Role {
  USER
  ADMIN
  CLIENT
  ARTISAN
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image            String?
  stripeCustomerId String?         @unique
  /// Crédits d’analyse de devis (défaut 1 pour les comptes existants)
  analysisCredits  Int             @default(1)
  accounts         Account[]
  sessions         Session[]
  role             Role            @default(USER)
  Authenticator    Authenticator[]
  artisan          Artisan?
  analysisHistory  AnalysisHistory[]
  payments         Payment[]
  clientConversations Conversation[] @relation("ClientConversation")
  artisanConversations Conversation[] @relation("ArtisanConversation")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

/// Historique des analyses (utilisateurs connectés)
model AnalysisHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  reliability Float
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

/// Une analyse gratuite par empreinte IP (invités non connectés)
model GuestAnalysisUsage {
  id        String   @id @default(cuid())
  ipHash    String   @unique
  createdAt DateTime @default(now())
}

model Artisan {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber     String
  siret           String?
  firstName       String
  lastName        String
  email           String
  address         String
  coordinates     String? // JSON string for [lat, lng]
  companyName     String?
  legalName       String?
  legalStatus     String?
  services        String?
  experienceYears String?
  specialties     String?
  description     String?
  image           String?
  workPhotos      String[] // Array of image URLs (work photos)
  professionalGuarantees String[] // Array of file URLs (garanties professionnelles: images or PDFs)
  rating          Float?
  reviews         Int?
  verified        Boolean  @default(false)
  location        String?
  distance        Float?
  availability    String?
  certifications  String[] // Array of certification names (RGE, Qualibat, etc.)
  certificationUrls String[] // Array of certification file URLs (images or PDFs)
  profession      String?
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Blog {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  content       String
  excerpt       String?
  featuredImage String?
  previewImage  String?
  author        String?
  tags          String[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  reactions     Reaction[]
}

model Reaction {
  id        String       @id @default(cuid())
  count     Int?         @default(1)
  section   String?
  type      ReactionType @default(CLAPPING)
  createdAt DateTime     @default(now())
  sessionId String

  contentId String
  content   Blog   @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

enum ReactionType {
  CLAPPING
  THINKING
  AMAZED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId       String        @unique
  stripePaymentIntentId String?
  stripeEventId         String?       @unique
  amount                Int
  currency              String
  status                PaymentStatus @default(PENDING)
  creditsAdded          Int           @default(0)
  metadata              Json?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum ConversationStatus {
  QUOTE_SIGNED
  IN_PROGRESS
  PENDING
}

enum MessageFrom {
  CLIENT
  ARTISAN
  SYSTEM
}

enum MessageContentType {
  TEXT
  QUOTE
  ALERT
}

model Conversation {
  id          String             @id @default(cuid())
  clientId    String
  artisanId   String
  client      User               @relation("ClientConversation", fields: [clientId], references: [id], onDelete: Cascade)
  artisan     User               @relation("ArtisanConversation", fields: [artisanId], references: [id], onDelete: Cascade)
  status      ConversationStatus @default(PENDING)
  isUnreadByClient  Boolean      @default(false)
  isUnreadByArtisan Boolean      @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  messages    Message[]

  @@index([clientId, updatedAt])
  @@index([artisanId, updatedAt])
}

model Message {
  id             String             @id @default(cuid())
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from           MessageFrom
  contentType    MessageContentType
  text           String?
  payload        Json?
  readAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([conversationId, createdAt])
}
